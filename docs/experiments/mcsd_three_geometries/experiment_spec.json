    "guide": "RESEARCH_OBJECTIVES.md",
    "objective": "Test coverage, within-constraint competitiveness, quality-cost tradeoffs, and mechanisms; use evidence to improve algorithms without overwriting the reference definitions.",
    "hypotheses": ["H1", "H2", "H3", "H4", "H5", "H6"],
    "primary_endpoint": "Final-checkpoint held-out NLL at equal actual training tokens, compared within each constraint; report every paired seed difference.",
    "cost_endpoint": "NLL versus synchronized training time and GPU-hours, with evaluation and diagnostic costs disclosed separately.",
    "development_selection_data": "validation only; never final held-out evaluation",
    "require_formal_protocol_lock": true,
    "practical_effect_thresholds": "Set and justify on development evidence before formal evaluation; not a universal fixed threshold.",
    "mechanism_controls": [
      "Frobenius: input/output tangent-projection 2x2 with common EMA, LMO, return and scale",
      "Frobenius: effective-step and actual-angle matching at the same state",
      "Stiefel: square versus rectangular block tangency and update differences",
      "Spectral: matched-return controls only in audited smooth local regions",
      "Separate LMO approximation and return approximation effects"
    ],
    "controls_are_additional_to_main_run_matrix": true,
    "max_structural_candidates_per_iteration": 2,
    "initial_smoke_max_steps_per_method_or_registered_variant": 100,
    "initial_scope_includes": [
      "reference implementation and tests",
      "evidence-based bug fixes",
      "mathematically equivalent performance optimization",
      "separately registered single-factor variant development and short checks",
      "research diagnosis and next-stage costed commands"
    ],
    "structural_change_requires": [
      "new method and config identifiers",
      "retained original reference",
      "explicit equation or order change",
      "theory applicability statement",
      "minimal control and rejection criterion",
      "logged exploratory compute cost"
    ],
    "protocol_change_requires": "New protocol version and comparable reruns for affected methods; do not mix with the frozen main table.",
    "decision_log": "research/algorithm_decisions.md",
    "theory_alignment": "research/theory_alignment.md",
    "claim_evidence": "research/claim_evidence.md",
    "three_geometries_do_not_complete_nonsmooth_mcsd_pgd_validation": true,
    "must_beat_every_baseline": false
